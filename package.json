{
  "name": "avo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/create-service-worker.mjs",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "start": "vite preview",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "test": "vitest run --exclude=lib/auth.test.ts --exclude=tests/account-data-route.test.ts --exclude=tests/auth-route.test.ts --exclude=tests/migration-runner-cli.test.ts --exclude=tests/migration-runner-postgres.test.ts --exclude=lib/db/migration-runner.test.ts --exclude=lib/db/inspection.test.ts",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit -p tsconfig.cloudflare.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint --max-warnings=0 app components lib workers vite.config.ts react-router.config.ts",
    "format:check": "prettier --check app components lib workers tests scripts/create-service-worker.mjs scripts/d1-recovery.mjs scripts/prepare-cloudflare-production.mjs package.json wrangler.jsonc react-router.config.ts vite.config.ts",
    "db:check": "drizzle-kit check --dialect=sqlite --out=./drizzle-d1",
    "db:migrate:local": "wrangler d1 migrations apply avo --local --force",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test:dependencies": "node --test scripts/check-dependencies.test.mjs",
    "check:tasks": "node scripts/check-tasks.mjs",
    "test:tasks": "node --test scripts/check-tasks.test.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.7.28",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "use-intl": "^4.15.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261124.2",
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
